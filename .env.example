# Enterprise AI Agent Platform v1.0 - Environment Configuration
# Copy to .env and fill in your values before running.

# ─── Application ───
APP_NAME=Enterprise AI Agent Platform
APP_VERSION=1.0.0
SERVICE_NAME=enterprise-ai-agent-platform
DEBUG=false
ENVIRONMENT=development

# ─── Database ───
# SQLite for development, PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./data/knowledge.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── ChromaDB Vector Store ───
# Docker Compose 映射为 8001:8000；本机连容器请用 8001
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=knowledge_docs

# ─── LLM Client ───
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ─── Embedding ───
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSION=1536

# ─── Knowledge Base ───
KNOWLEDGE_BASE_DIR=./data/knowledge
UPLOAD_DIR=./data/uploads

# ─── JWT / Security ───
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ─── OpenTelemetry (optional; leave empty to disable exporter) ───
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Grafana ───
GRAFANA_PASSWORD=admin

# ─── Sync Connectors ───
FEISHU_APP_ID=
FEISHU_APP_SECRET=
YUQUE_TOKEN=

# ─── Integration (Project 1 / Project 2) ───
# 项目 1 与本项目默认都占用 :8000，并行时把项目 1 改到 8100 并同步这里
PROJECT1_API_BASE=http://localhost:8000
PROJECT1_API_KEY=
# 项目 2 默认是 stdio MCP，没有 HTTP /tools。仅当自建了 HTTP 包装时填写：
PROJECT2_MCP_PATH=
ENTERPRISE_DEVOPS_MCP_URL=