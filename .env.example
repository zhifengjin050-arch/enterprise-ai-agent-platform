# Enterprise AI Agent Platform v1.0 - Environment Configuration
# Copy to .env and fill in your values before running.

# ─── Application ───
APP_NAME=Enterprise AI Agent Platform
DEBUG=false

# ─── Database ───
# SQLite for development, PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./data/knowledge.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── ChromaDB Vector Store ───
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=knowledge_docs

# ─── LLM Client ───
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ─── Embedding ───
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSION=1536

# ─── Knowledge Base ───
KNOWLEDGE_BASE_DIR=./data/knowledge
UPLOAD_DIR=./data/uploads

# ─── JWT / Security ───
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ─── OpenTelemetry ───
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─── Grafana ───
GRAFANA_PASSWORD=admin

# ─── Sync Connectors ───
FEISHU_APP_ID=
FEISHU_APP_SECRET=
YUQUE_TOKEN=

# ─── Integration (Project 1 / Project 2) ───
PROJECT1_API_BASE=http://localhost:8000
PROJECT1_API_KEY=
PROJECT2_MCP_PATH=